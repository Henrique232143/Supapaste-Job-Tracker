msgid "Adicionar empresa"
msgstr "Unternehmen hinzufügen"

msgid "Adicionar cargo"
msgstr "Jobtitel hinzufügen"

msgid "Cancelar"
msgstr "Abbrechen"

msgid "Salvar candidatura"
msgstr "Bewerbung speichern"

